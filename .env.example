# ============================================================
#  环境变量模板 — 复制为 .env (已被 .gitignore 忽略) 并填入真实值
#  注意: 下列凭据一旦曾以明文出现在仓库, 必须在服务端立即轮换!
# ============================================================

# --- 前端部署 (scripts/deploy_frontend.py) ---
DEPLOY_HOST=47.95.124.216
DEPLOY_USER=root
# 二选一: 密码 或 SSH 私钥 (优先用密钥)
DEPLOY_PASSWORD=
DEPLOY_KEY_PATH=
# 远端前端目录, 多个用逗号分隔
DEPLOY_REMOTE_DIRS=/opt/weikongbu/frontend

# --- 后端数据库 (java-backend application.properties) ---
# 建议: DB 与 SSH 使用互不相同的独立凭据
DB_USERNAME=
DB_PASSWORD=
