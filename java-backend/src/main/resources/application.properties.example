server.port=8080
server.address=0.0.0.0
spring.application.name=h5-horror-game

# ============================================================
#  MySQL RDS
#  真实凭据不要写进本文件。复制本文件为 application.properties
#  (已被 .gitignore 忽略), 或用环境变量 / systemd EnvironmentFile 注入。
#  占位写法: ${ENV_VAR:default}
# ============================================================
spring.datasource.url=jdbc:mysql://YOUR_DB_HOST:3306/horror_game?useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
spring.datasource.username=${DB_USERNAME}
spring.datasource.password=${DB_PASSWORD}
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

# JPA
# 生产建议改为 validate, 让 sql/schema.sql 成为表结构唯一真相源
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=false
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.MySQL8Dialect

# Jackson - 支持 snake_case JSON
spring.jackson.property-naming-strategy=SNAKE_CASE
spring.jackson.default-property-inclusion=non_null
